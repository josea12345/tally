# Copy to .env and fill in. Never commit .env — it holds a live key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Free TMDB API key (themoviedb.org → Settings → API). Enables title search for movies/TV.
VITE_TMDB_API_KEY=
# Free OMDb API key (omdbapi.com). Enables real IMDb ratings on movie/TV drops.
VITE_OMDB_API_KEY=
# Web Push VAPID public key (safe to expose — baked into the app).
VITE_VAPID_PUBLIC_KEY=
